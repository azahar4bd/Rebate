# Copy to .env.local for development. Never commit real credentials.
# Set these values in the EXISTING Vercel project's Environment Variables too.

# Neon/PostgreSQL connection string, including TLS parameters provided by Neon.
# Example: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Choose a strong, unique admin password. Admin access is disabled if blank.
ADMIN_PASSWORD=

# Generate your own random secret (32 bytes recommended):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
